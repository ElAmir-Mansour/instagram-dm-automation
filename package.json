{
  "name": "instagram-dm-automation",
  "version": "1.0.0",
  "description": "Free, open-source Instagram Comment-to-DM automation using Meta Graph API. A self-hosted alternative to ManyChat.",
  "main": "src/index.ts",
  "scripts": {
    "start:dev": "node --env-file=.env --loader ts-node/esm src/index.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "migrate:status": "node --env-file=.env scripts/migrate.mjs --status",
    "profiles:backfill": "tsx scripts/backfill-creator-profiles.mts",
    "profiles:parity": "tsx scripts/prompt-parity.mts",
    "check:assets": "node scripts/check-asset-version.mjs",
    "check:icons": "node scripts/check-rtl-icons.mjs",
    "check:icon-subset": "node scripts/build-icons.mjs --check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:voice": "node scripts/check-voice.mjs",
    "check:docs": "node scripts/check-doc-refs.mjs",
    "docs:reanchor": "node scripts/check-doc-refs.mjs --reanchor",
    "build:hero3d": "node scripts/build-hero3d.mjs",
    "check:hero3d": "node scripts/build-hero3d.mjs --check",
    "build:font": "node scripts/build-font.mjs",
    "check:font": "node scripts/build-font.mjs --check",
    "build:og": "node scripts/build-og.mjs",
    "check:og": "node scripts/build-og.mjs --check",
    "build:brand-icons": "node scripts/build-brand-icons.mjs",
    "check:brand-icons": "node scripts/build-brand-icons.mjs --check"
  },
  "keywords": [
    "instagram",
    "automation",
    "dm",
    "direct-message",
    "comment-to-dm",
    "meta-api",
    "instagram-graph-api",
    "manychat-alternative",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElAmir-Mansour/instagram-dm-automation.git"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/functions": "3.9.9",
    "axios": "^1.16.1",
    "body-parser": "^2.2.2",
    "express": "^5.2.1",
    "ffmpeg-static": "5.3.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "esbuild": "0.28.2",
    "simple-icons": "16.33.0",
    "three": "0.186.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
