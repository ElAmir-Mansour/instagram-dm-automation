# Server Configuration
PORT=3000

# Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Meta Webhook Verification Token
META_VERIFY_TOKEN=your_secure_random_string_here

# Meta App ID
# Get this from: Meta Developer Console → App Settings → Basic → App ID
META_APP_ID=your_facebook_app_id_here

# Meta App Secret
# Get this from: Meta Developer Console → App Settings → Basic → App Secret
META_APP_SECRET=your_facebook_app_secret_here

# Dashboard Password
DASHBOARD_PASSWORD=your_dashboard_password_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here


# Instagram App Secret (Instagram API with Instagram Login)
# This is a SEPARATE app from the Facebook one above, with its own secret.
# Instagram comment/message webhooks are signed with THIS secret, not META_APP_SECRET.
# Get this from: Meta Developer Console → Use cases → Instagram API → Instagram app secret
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here

# Meta token encryption key — encrypts creators.page_access_token at rest
# Generate with: openssl rand -hex 32
#
# Deliberately NOT required at startup. A stored token without the `enc:v1:` prefix is read
# back as-is, so a deployment that still holds plaintext tokens keeps working without this set
# — each token becomes encrypted the next time it is saved. It IS required to save a new token
# or create a tenant, and those endpoints say so.
TOKEN_ENCRYPTION_KEY=

# Cron Secret — guards GET /api/cron/publish and GET /api/jobs/drain
# Required at startup. Without it the publish endpoint used to fail OPEN, letting anyone
# trigger publishing of every pending post. Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here


# ─── Optional: logging ──────────────────────────────────────────────────────
# Minimum level emitted: debug | info | warn | error. Defaults to info.
# `debug` is useful locally; on Vercel it is noisy and each line costs log retention.
LOG_LEVEL=

# Set to 1 to include stack traces in error lines. Off by default — on Vercel a stack
# triples the line length and every frame is in this repo anyway.
LOG_STACKS=


# ─── Optional: job queue ────────────────────────────────────────────────────
# The webhook writes each event to the `jobs` table before acknowledging Meta, then drains
# what it can inside the same invocation. Requires migration v13.
#
# Escape hatch: set to `off` to go back to processing inline with no queue at all. The app
# also falls back to that automatically if the enqueue fails, so this is for deliberate
# rollback rather than for fault tolerance.
WEBHOOK_QUEUE=

# Milliseconds a webhook invocation will spend draining after it has answered Meta.
# Default 8000. Lower it if webhook invocations are being killed on duration.
JOB_INLINE_BUDGET_MS=

# Milliseconds GET /api/jobs/drain will work for. Default 45000 — keep it comfortably under
# the function's configured maxDuration.
JOB_WORKER_BUDGET_MS=


# ─── Optional: data retention ───────────────────────────────────────────────
# Days to keep `messages.raw_payload` — the verbatim Meta event stored with every DM.
#
# Days to keep the verbatim Meta webhook payload in messages.raw_payload.
#
# 30, because that is what the published /data-deletion page commits to — this value is a
# promise to users, not a preference. (This key was previously declared twice, once empty
# with a recommendation of 90 and once as 30, so which one applied depended on the parser.)
#
# UNSET MEANS KEEP FOREVER, which makes that published promise untrue: clearing
# messages.text while raw_payload still holds the same text deletes nothing. It is also a
# storage cost on a 500MB tier and a standing privacy exposure, holding message bodies and
# Meta user ids for people who never interacted again.
#
# Minimum accepted is 7; anything shorter would destroy the evidence needed to debug a live
# webhook problem. Only the redundant `raw_payload` column is cleared — message text,
# direction and timestamps are what the inbox and the AI history window read, and are never
# touched.
RAW_PAYLOAD_RETENTION_DAYS=30
