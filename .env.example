# Server Configuration
PORT=3000

# Supabase PostgreSQL Connection String
# Get this from: Supabase Dashboard → Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Meta Webhook Verification Token
# This can be any random string you choose. You'll use the same value when configuring webhooks in Meta Developer Console.
META_VERIFY_TOKEN=your_secure_random_string_here

# Meta App Secret
# Get this from: Meta Developer Console → App Settings → Basic → App Secret
META_APP_SECRET=your_facebook_app_secret_here
