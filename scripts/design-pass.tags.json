{
  "title": "Design pass 2026-09-27 (feat/design-pass) — every value that changed, by the decision that claims it",
  "decisions": {
    "1": "Radii: inner panels, list rows and wells at --radius-md; media frames at --radius-sm; .badge a pill",
    "2": "One callout recipe; one tinted border per tone (--border-info/-warning/-danger/-success)",
    "3": "Step marks: 24px, --fs-100 semibold, everywhere",
    "4": "Meters: progress meters 6px (sweep 4px and .platform-bar 10px unchanged)",
    "5": "Empty states: one padding (--space-6 --space-4) and gap (--space-3)",
    "6": "The slide forms: a flex column with a --space-4 gap; the inert declarations gone",
    "7": "Studio card padding: outer 24, inner and list cards 16, no 12+16 mixes",
    "8": "Card titles --fs-400 semibold --text-strong; card/section heads end at --space-4",
    "9": "Selected is an inset ring, not a focus ring",
    "10": "One narrow breakpoint: the 900px block folded into 860px"
  },
