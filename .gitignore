dist/
.DS_Store
# docs/ holds the maintainers' local notes and specs (kept out of this public repo), EXCEPT the operator
# guides: any docs/*_GUIDE.md is tracked by default, so a new guide can't silently stay local.
docs/*
!docs/*_GUIDE.md
# The Muse benchmark's two outputs (scripts/eval-muse.mts) are public, so this folder is tracked too.
!docs/hackathon/
.env*.local
.env.production

# Local-only assistant notes and config — keep out of the public repo
CLAUDE.md
.claude/

# Local scratch scripts. These were tracked in a PUBLIC repo with the production
# database password and a live Meta token hardcoded in them. Never track them again.
scratch/
query_posts_temp.js
post_scheduler_status.html

# Belt and braces: .env alone did not cover .env.production, which was committed once.
.env*
!.env.example
